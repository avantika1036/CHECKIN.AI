# Copy this file to .env and fill in. NEVER commit .env (it is in .gitignore).

# --- AI models. LLM_PROVIDER = which to use, in order. "groq,gemini" = Groq first, Gemini as the backup.
LLM_PROVIDER=groq,gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# seconds to wait for one AI call before giving up and using the backup (lower = snappier failover)
LLM_TIMEOUT_SECONDS=10

# --- security
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters
SEED_PASSWORD=changeme123
